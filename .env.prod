# =========================================================
#  .env.prod — шаблон настроек для Docker Compose деплоя
#  Использование: скопируй в .env перед `docker compose up -d`
#        cp .env.prod .env   # затем подставь свои токены
# =========================================================

# ---------------- PostgreSQL ----------------------------
# Хост = имя сервиса `db` в docker-compose.yml
DB_HOST=db
# Внутренний порт PostgreSQL в Docker сети (не 5433 — это хостовый)
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_NAME=yupoo_db

# ---------------- Telegram Bot --------------------------
# Токен бота из @BotFather
TG_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
# ID чата/канала с альбомами (начинается с -100 для супергрупп)
TG_CHAT_ID=-1000000000000
# Username менеджера для хлебных крошек / ссылки
MANAGER_USERNAME=ManagerSem

# ---------------- Proxy (опционально) -------------------
# Если сервер находится в РФ и нужен прокси для Telegram:
# PROXY_URL=socks5://user:pass@proxy.example.com:1080
# PROXY_URL=http://127.0.0.1:10808

# ---------------- Crawler keywords ----------------------
# Список брендов / ключевых слов для crawl discovery (через запятую)
CRAWL_KEYWORDS=ADIDAS,NIKE,JORDAN,BALENCIAGA,ARCTERYX,STONE ISLAND

# ---------------- Vitrine — главная страница ------------
# Рук. управление «Популярными брендами» (через запятую, регистр не важен)
# Оставь пустым или закомментируй, чтобы список брался из CRAWL_KEYWORDS
RECOMMENDED_BRANDS=NIKE,ADIDAS,JORDAN,ARCTERYX,BALENCIAGA,STONE ISLAND
